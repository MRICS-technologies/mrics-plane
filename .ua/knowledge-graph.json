      "id": "module:plane-repository",
      "type": "module",
      "name": "plane (monorepo)",
      "filePath": ".",
      "summary": "Open-source project management monorepo that declares five applications, nine shared packages, and infrastructure boundaries through the root workspace manifests, Turbo pipeline, Docker Compose, and GitHub Actions workflows.",
      "tags": [
        "monorepo",
        "workspace",
        "plane",
        "architecture-landscape"
      ],
      "complexity": "complex"
    },
    {
      "id": "module:app:api",
      "type": "module",
      "name": "plane-api",
      "filePath": "apps/api",
      "summary": "Django/Python API server powering Plane's backend. Built from apps/api via Dockerfile.api, excluded from the pnpm workspace, and depended on at runtime by web, admin, and space.",
      "tags": [
        "application",
        "backend",
        "django",
        "python",
        "api"
      ],
      "complexity": "complex"
    },
    {
      "id": "module:app:web",
      "type": "module",
      "name": "web",
      "filePath": "apps/web",
      "summary": "React Router web application (port 3000) for the main Plane interface. Declares every principal @plane package as a workspace dependency and depends on the API at runtime.",
      "tags": [
        "application",
        "frontend",
        "react-router",
        "web"
      ],
      "complexity": "complex"
    },
    {
      "id": "module:app:admin",
      "type": "module",
      "name": "admin",
      "filePath": "apps/admin",
      "summary": "React Router admin UI (port 3001) for Plane administration. Consumes shared packages and depends on the API and web apps at runtime.",
      "tags": [
        "application",
        "frontend",
        "react-router",
        "admin"
      ],
      "complexity": "moderate"
    },
    {
      "id": "module:app:space",
      "type": "module",
      "name": "space",
      "filePath": "apps/space",
      "summary": "React Router public project-space application (port 3002) that publishes project pages. Consumes shared packages and depends on the API and web apps at runtime.",
      "tags": [
        "application",
        "frontend",
        "react-router",
        "space"
      ],
      "complexity": "moderate"
    },
    {
      "id": "module:app:live",
      "type": "module",
      "name": "live",
      "filePath": "apps/live",
