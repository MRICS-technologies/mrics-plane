# ============================================================
# MRICS Plane — self-hosted deployment configuration
# Copy to `.env` next to docker-compose.yml and fill in values.
# Generate secrets with:  openssl rand -hex 32   (or -base64 24)
# ============================================================

# --- Public access ---------------------------------------------------------
# Domain that points at this server (A/AAAA DNS record).
PLANE_PUBLIC_DOMAIN=plane.example.com
# Full public URL (scheme + domain). Must match PLANE_PUBLIC_DOMAIN.
WEB_URL=https://plane.example.com

# --- Required secrets ------------------------------------------------------
SECRET_KEY=change-me-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-openssl-rand-hex-16
RABBITMQ_PASSWORD=change-me-openssl-rand-hex-16
ADMIN_PASSWORD=change-me-initial-admin-password
LIVE_TOKEN=change-me-openssl-rand-hex-16

# MinIO root credentials (S3-compatible file storage)
AWS_ACCESS_KEY_ID=change-me-minio-user
AWS_SECRET_ACCESS_KEY=change-me-minio-password

# --- Optional with sane defaults ------------------------------------------
POSTGRES_USER=plane
POSTGRES_DB=plane
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
S3_BUCKET_NAME=uploads
AWS_REGION=us-east-1
ADMIN_EMAIL=admin@example.com

# --- Images (multi-arch: amd64 + arm64) ------------------------------------
# Pin to a specific tag for reproducible deploys, e.g. :dev-abc1234
PLANE_BACKEND_IMAGE=ghcr.io/mrics-technologies/mrics-plane-backend:dev
PLANE_FRONTEND_IMAGE=ghcr.io/mrics-technologies/mrics-plane-frontend:dev
PLANE_ADMIN_IMAGE=ghcr.io/mrics-technologies/mrics-plane-admin:dev

# --- Reverse proxy (Traefik) ----------------------------------------------
# Name of the external network your Traefik lives on (Coolify default: coolify)
PLANE_PROXY_NETWORK=coolify
PLANE_TRAEFIK_ENABLE=true
PLANE_TRAEFIK_ENTRYPOINT=https
PLANE_TRAEFIK_TLS=true
PLANE_TLS_RESOLVER=letsencrypt
# For plain-HTTP local testing (no certs): set PLANE_TRAEFIK_TLS=false
